# ---------- App ----------
NEXT_PUBLIC_APP_URL=https://rendez-vous.app
APP_DOMAIN=rendez-vous.app

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------- Stripe ----------
# Le catalogue Pro (prix mensuel / annuel par agenda) et le portail client sont créés automatiquement
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Frais de service plateforme prélevés sur les acomptes (0 = aucun, max 20)
PLATFORM_DEPOSIT_FEE_PERCENT=0
# Endpoint "Your account" (abonnements Pro des professionnels)
STRIPE_WEBHOOK_SECRET=whsec_...
# Endpoint "Connected accounts" (acomptes clients + account.updated)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# ---------- Emails (Resend) ----------
RESEND_API_KEY=re_...
EMAIL_FROM="Rendez-vous <bonjour@rendez-vous.app>"
# Adresse de réponse des emails de prospection (routée par Cloudflare Email Routing vers le Worker)
EMAIL_REPLY_TO=bonjour@rendez-vous.app
OWNER_ALERT_EMAIL=vous@exemple.fr

# ---------- Agent email IA ----------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5
# Assistant IA usager (chat in-app)
ASSISTANT_MODEL=claude-opus-5-5
# Secret partagé avec le Cloudflare Email Worker
INBOUND_EMAIL_SECRET=change-me-long-random
# Secret HMAC des liens d'onboarding pré-remplis (?prefill=...)
PREFILL_SECRET=change-me-long-random
# Jetons de désinscription en 1 clic (même valeur dans les secrets GitHub du robot)
UNSUBSCRIBE_SECRET=change-me-long-random
# Resend > Webhooks (email.bounced, email.complained, email.delivered) -> /api/webhooks/resend
RESEND_WEBHOOK_SECRET=whsec_...

# ---------- Référencement ----------
# Clé IndexNow (chaîne hexadécimale de 32 caractères, ex. openssl rand -hex 16)
INDEXNOW_KEY=
# Codes de vérification Google Search Console et Bing Webmaster Tools (balises meta)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---------- Crons ----------
CRON_SECRET=change-me-long-random

# ---------- Prospection (scripts/prospector.py) ----------
SERPER_API_KEY=...
# auto = envoi réel automatique dès que /api/health/readiness est vert ; true = simulation ; false = forcé
DRY_RUN=auto
HARD_MAX_EMAILS_PER_DAY=6000
# Plafond absolu ; le débit réel monte progressivement (warm-up) et freine seul si rebonds/plaintes augmentent
MAX_EMAILS_PER_DAY=1500
WARMUP_START=40
WARMUP_GROWTH=1.3
RUNS_PER_DAY=5
CONCURRENCY=8
PROSPECT_CITIES=Paris,Lyon,Marseille,Toulouse,Bordeaux,Lille,Nantes,Nice,Strasbourg,Montpellier
# Vide = tous les métiers du catalogue (slugs de src/config/categories.ts, séparés par des virgules)
PROSPECT_CATEGORIES=
# Vide = calculé automatiquement selon le budget de l'exécution
MAX_SEARCHES_PER_RUN=
