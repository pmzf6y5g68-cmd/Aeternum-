{"text": "<meta name=\"dash-one-writer\">\n<style>\n.ae { display: grid; gap: var(--cds-gap-xl); font-family: var(--font-anthropic-sans); color: var(--color-fg); }\n.ae-head { display: grid; gap: var(--cds-gap-sm); }\n.ae-head h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n.ae-lede { font-size: var(--cds-font-size-heading); line-height: 1.45; max-width: 68ch; margin: 0; text-wrap: pretty; }\n.ae-lede b { font-weight: var(--cds-font-weight-medium); }\n.ae-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--cds-gap-md); }\n@media (max-width: 720px) { .ae-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.ae-tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: grid; gap: var(--cds-gap-xs); align-content: start; }\n.ae-tile .ae-v { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: 2.1rem; line-height: 1.1; font-variant-numeric: tabular-nums; }\n.ae-tile .ae-l { font-size: var(--cds-font-size-body); }\n.ae-tile .ae-s { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.ae-sec { display: grid; gap: var(--cds-gap-sm); min-width: 0; }\n.ae-sec h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; text-wrap: balance; }\n.ae-note { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); line-height: 1.5; max-width: 78ch; margin: 0; }\n.ae-chart { position: relative; min-height: 300px; }\n.ae-chart.ae-short { min-height: 190px; }\n.ae-chart svg { display: block; overflow: visible; }\n.ae-tip { position: absolute; z-index: 2; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); box-shadow: var(--cds-shadow-popover); border-radius: var(--cds-radius); padding: 6px 9px; font-size: var(--cds-font-size-caption); line-height: 1.45; max-width: 290px; }\n.ae-tip b { font-weight: var(--cds-font-weight-medium); }\n.ae-tip .ae-k { color: var(--cds-text-secondary); }\n.ae .axis text { fill: var(--cds-text-secondary); font-size: var(--cds-font-size-caption); font-family: var(--font-anthropic-sans); }\n.ae .axis path, .ae .axis line { stroke: var(--cds-chart-axis); }\n.ae .grid line { stroke: var(--cds-chart-grid); }\n.ae .grid path { display: none; }\n.ae-legend { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin-top: var(--cds-gap-xs); }\n.ae-legend span { display: inline-flex; align-items: center; gap: 6px; }\n.ae-legend i { display: inline-block; width: 12px; height: 3px; border-radius: 2px; }\n.ae-legend i.ae-sq { height: 10px; width: 10px; }\n.ae-recipe { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: var(--cds-gap-md) var(--cds-gap-lg); background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); margin: 0; }\n.ae-recipe div { display: grid; gap: 2px; min-width: 0; }\n.ae-recipe dt { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.ae-recipe dd { margin: 0; overflow-wrap: anywhere; }\n.ae-recipe .ae-wide { grid-column: 1 / -1; }\n.ae-recipe .ae-path { font-family: var(--font-anthropic-serif); font-size: var(--cds-font-size-heading); }\n.ae-tablewrap { overflow-x: auto; }\n.ae table { border-collapse: collapse; width: 100%; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n.ae th, .ae td { text-align: left; padding: 7px 9px; border-bottom: 1px solid var(--color-border-line); white-space: nowrap; vertical-align: top; }\n.ae th { color: var(--color-fg-muted); font-weight: var(--cds-font-weight-medium); }\n.ae th.n, .ae td.n { text-align: right; }\n.ae td.ae-wrap { white-space: normal; min-width: 210px; }\n.ae tr.ae-dead td { color: var(--color-fg-muted); }\n.ae-pill { display: inline-block; padding: 1px 7px; border-radius: 999px; font-size: var(--cds-font-size-caption); border: 1px solid var(--color-border-line); }\n.ae-pill.ok { color: var(--color-ok); border-color: currentColor; }\n.ae-pill.bad { color: var(--color-bad); border-color: currentColor; }\n.ae-pill.warn { color: var(--color-warn); border-color: currentColor; }\n.ae details { border-top: 1px solid var(--color-border-line); padding-top: var(--cds-gap-md); }\n.ae details summary { cursor: pointer; font-weight: var(--cds-font-weight-medium); }\n.ae details p, .ae details li { color: var(--color-fg-muted); font-size: var(--cds-font-size-body); line-height: 1.55; max-width: 78ch; }\n.ae-fail { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); padding: var(--cds-pad-md) 0; }\n.ae-duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--cds-gap-lg); }\n@media (max-width: 720px) { .ae-duo { grid-template-columns: minmax(0, 1fr); } }\n.ae-h3 { font-size: var(--cds-font-size-body); font-weight: var(--cds-font-weight-medium); margin: 0; color: var(--color-fg-muted); }\n.ae-chart.ae-bars { min-height: 120px; }\n</style>\n\n<div class=\"ae\" lang=\"fr\" data-read>\n\n<header class=\"ae-head\" id=\"entete\">\n  <h1>Évolution Aeternum</h1>\n  <p class=\"ae-lede\">Après <b data-draw=\"nb-gen\" data-source=\"campagne\" data-field=\"generations\" data-row=\"0\">—</b> générations d'évolution et <b data-draw=\"nb-vies\" data-source=\"campagne\" data-field=\"vies_simulees\" data-row=\"0\">—</b> vies simulées mois par mois, la stratégie qui survit le mieux est : <b data-draw=\"champion\" data-source=\"champions\" data-field=\"parcours\" data-row=\"0\">—</b>.</p>\n  <p class=\"ae-note\">Profil simulé : seul, jeune, sans expérience ni réseau, en France, environ 1 500 € d'épargne. « 10 k€/mois » = bénéfice mensuel du fondateur avant impôts, tenu 3 mois de suite. « Licorne » = entreprise valorisée au moins 1 milliard de dollars.</p>\n</header>\n\n<section class=\"ae-tiles\" id=\"chiffres-cles\" aria-label=\"Chiffres clés de la stratégie gagnante\">\n  <div class=\"ae-tile\" id=\"tuile-12m\">\n    <span class=\"ae-l\">10 k€/mois atteint en 12 mois</span>\n    <span class=\"ae-v\"><span data-draw=\"t-12\" data-source=\"champions\" data-field=\"p10k_12m_pct\" data-row=\"0\">—</span> %</span>\n    <span class=\"ae-s\">des vies simulées</span>\n  </div>\n  <div class=\"ae-tile\" id=\"tuile-24m\">\n    <span class=\"ae-l\">10 k€/mois atteint en 24 mois</span>\n    <span class=\"ae-v\"><span data-draw=\"t-24\" data-source=\"champions\" data-field=\"p10k_24m_pct\" data-row=\"0\">—</span> %</span>\n    <span class=\"ae-s\">des vies simulées</span>\n  </div>\n  <div class=\"ae-tile\" id=\"tuile-durable\">\n    <span class=\"ae-l\">Encore ≥ 10 k€/mois à 5 ans</span>\n    <span class=\"ae-v\"><span data-draw=\"t-dur\" data-source=\"champions\" data-field=\"p_durable_60m_pct\" data-row=\"0\">—</span> %</span>\n    <span class=\"ae-s\">pérennité</span>\n  </div>\n  <div class=\"ae-tile\" id=\"tuile-part\">\n    <span class=\"ae-l\">Temps passé à ≥ 10 k€/mois</span>\n    <span class=\"ae-v\"><span data-draw=\"t-part\" data-source=\"champions\" data-field=\"part_temps_10k_pct\" data-row=\"0\">—</span> %</span>\n    <span class=\"ae-s\">en moyenne, de la 3ᵉ à la 10ᵉ année</span>\n  </div>\n  <div class=\"ae-tile\" id=\"tuile-licorne\">\n    <span class=\"ae-l\">Potentiel licorne</span>\n    <span class=\"ae-v\"><span data-draw=\"t-lic\" data-source=\"champions\" data-field=\"p_licorne_pct\" data-row=\"0\">—</span> %</span>\n    <span class=\"ae-s\">probabilité modélisée, sur 10 ans</span>\n  </div>\n  <div class=\"ae-tile\" id=\"tuile-abandon\">\n    <span class=\"ae-l\">Abandonnent en route</span>\n    <span class=\"ae-v\"><span data-draw=\"t-ab\" data-source=\"champions\" data-field=\"p_abandon_pct\" data-row=\"0\">—</span> %</span>\n    <span class=\"ae-s\">épuisement, stagnation, échec</span>\n  </div>\n</section>\n\n<section class=\"ae-sec\" id=\"recette\">\n  <h2>La recette gagnante, gène par gène</h2>\n  <dl class=\"ae-recipe\">\n    <div class=\"ae-wide\"><dt>Parcours</dt><dd class=\"ae-path\" data-draw=\"r-parcours\" data-source=\"champions\" data-field=\"parcours\" data-row=\"0\">—</dd></div>\n    <div><dt>Passage phase 1 → 2</dt><dd data-draw=\"r-p12\" data-source=\"champions\" data-field=\"passage_1_2\" data-row=\"0\">—</dd></div>\n    <div><dt>Passage phase 2 → 3</dt><dd data-draw=\"r-p23\" data-source=\"champions\" data-field=\"passage_2_3\" data-row=\"0\">—</dd></div>\n    <div><dt>Secteur visé</dt><dd data-draw=\"r-secteur\" data-source=\"champions\" data-field=\"secteur\" data-row=\"0\">—</dd></div>\n    <div><dt>Canal d'acquisition</dt><dd data-draw=\"r-canal\" data-source=\"champions\" data-field=\"canal\" data-row=\"0\">—</dd></div>\n    <div><dt>Niveau de prix</dt><dd data-draw=\"r-prix\" data-source=\"champions\" data-field=\"prix\" data-row=\"0\">—</dd></div>\n    <div><dt>Heures par semaine</dt><dd data-draw=\"r-heures\" data-source=\"champions\" data-field=\"heures\" data-row=\"0\">—</dd></div>\n    <div><dt>Associé</dt><dd data-draw=\"r-associe\" data-source=\"champions\" data-field=\"associe\" data-row=\"0\">—</dd></div>\n    <div><dt>Géographie</dt><dd data-draw=\"r-geo\" data-source=\"champions\" data-field=\"geographie\" data-row=\"0\">—</dd></div>\n    <div><dt>Financement</dt><dd data-draw=\"r-fin\" data-source=\"champions\" data-field=\"financement\" data-row=\"0\">—</dd></div>\n    <div><dt>Levée déclenchée à</dt><dd data-draw=\"r-levee\" data-source=\"champions\" data-field=\"declencheur_levee\" data-row=\"0\">—</dd></div>\n    <div><dt>Positionnement</dt><dd data-draw=\"r-pos\" data-source=\"champions\" data-field=\"positionnement\" data-row=\"0\">—</dd></div>\n    <div><dt>Garder l'agence en lançant le produit</dt><dd data-draw=\"r-garder\" data-source=\"champions\" data-field=\"garder_agence\" data-row=\"0\">—</dd></div>\n    <div><dt>Réinvestissement des bénéfices</dt><dd data-draw=\"r-reinv\" data-source=\"champions\" data-field=\"reinvestissement\" data-row=\"0\">—</dd></div>\n    <div><dt>Temps d'apprentissage</dt><dd data-draw=\"r-learn\" data-source=\"champions\" data-field=\"apprentissage\" data-row=\"0\">—</dd></div>\n    <div><dt>Temps sur le contenu</dt><dd data-draw=\"r-contenu\" data-source=\"champions\" data-field=\"contenu\" data-row=\"0\">—</dd></div>\n  </dl>\n</section>\n\n<section class=\"ae-sec\" id=\"trajectoire\">\n  <h2>Le revenu de la stratégie gagnante, mois par mois sur 10 ans</h2>\n  <p class=\"ae-note\">Bénéfice mensuel du fondateur avant impôts, sur 5 000 vies tracées. Ligne : médiane. Bande foncée : 25 % à 75 % des vies. Bande claire : 10 % à 90 %. Les vies qui abandonnent comptent avec leur salaire de repli. Le creux vers la 5ᵉ année correspond au lancement de la startup : on échange du revenu contre une chance de bâtir une entreprise de grande valeur.</p>\n  <div class=\"ae-chart\" data-draw=\"traj\" data-source=\"trajectoire\" role=\"img\" aria-label=\"Quantiles du revenu mensuel de la stratégie gagnante sur 120 mois\"></div>\n</section>\n\n<section class=\"ae-sec\" id=\"et-si\">\n  <h2>Et si on change un seul réglage ?</h2>\n  <p class=\"ae-note\">Chaque ligne modifie un seul gène de la stratégie gagnante et la réévalue sur 100 000 vies. Les écarts sont en points de pourcentage par rapport à la référence.</p>\n  <div class=\"ae-tablewrap\">\n    <table data-source=\"variantes\" data-row-key=\"variante\" aria-label=\"Effet d'un changement de réglage\">\n      <thead><tr>\n        <th data-field=\"variante\">Changement</th>\n        <th class=\"n\" data-field=\"p10k_24m_pct\">10 k€ en 24 mois</th>\n        <th class=\"n\" data-field=\"delta_24m_pts\">écart</th>\n        <th class=\"n\" data-field=\"p_durable_60m_pct\">≥ 10 k€ à 5 ans</th>\n        <th class=\"n\" data-field=\"delta_durable_pts\">écart</th>\n        <th class=\"n\" data-field=\"part_temps_10k_pct\">Temps à ≥ 10 k€, ans 3 à 10</th>\n        <th class=\"n\" data-field=\"p_licorne_pct\">Licorne</th>\n        <th class=\"n\" data-field=\"p_abandon_pct\">Abandon</th>\n      </tr></thead>\n      <tbody data-draw=\"tb-variantes\"></tbody>\n    </table>\n  </div>\n</section>\n\n<section class=\"ae-sec\" id=\"course-10k\">\n  <h2>Probabilité d'avoir atteint 10 k€/mois, mois après mois</h2>\n  <p class=\"ae-note\">Pour chaque voie, la meilleure version trouvée par l'évolution, évaluée sur 50 000 à 200 000 vies. Les vies qui abandonnent restent dans le calcul.</p>\n  <div class=\"ae-chart\" data-draw=\"courbe\" data-source=\"courbe10k\" role=\"img\" aria-label=\"Probabilité cumulée d'atteindre 10 000 euros par mois selon la stratégie, sur 120 mois\"></div>\n</section>\n\n<section class=\"ae-sec\" id=\"toutes-les-voies\">\n  <h2>La meilleure version de chaque voie</h2>\n  <p class=\"ae-note\">Une évolution séparée par voie, pour la juger dans les meilleures conditions possibles. Les gains d'une fraude détectée sont saisis et ne comptent pas.</p>\n  <div class=\"ae-tablewrap\">\n    <table data-source=\"moteurs\" data-row-key=\"moteur\" aria-label=\"Meilleure version de chaque voie\">\n      <thead><tr>\n        <th data-field=\"moteur\">Voie</th>\n        <th data-field=\"reglages\">Meilleurs réglages trouvés</th>\n        <th class=\"n\" data-field=\"p10k_12m_pct\">10 k€ en 12 mois</th>\n        <th class=\"n\" data-field=\"p10k_24m_pct\">en 24 mois</th>\n        <th class=\"n\" data-field=\"p_durable_60m_pct\">≥ 10 k€ à 5 ans</th>\n        <th class=\"n\" data-field=\"p_licorne_pct\">Licorne</th>\n        <th class=\"n\" data-field=\"p_abandon_pct\">Abandon</th>\n        <th class=\"n\" data-field=\"p_catastrophe_pct\">Prison, saisie</th>\n        <th class=\"n\" data-field=\"revenu_median_60m\">Revenu médian à 5 ans</th>\n      </tr></thead>\n      <tbody data-draw=\"tb-moteurs\"></tbody>\n    </table>\n  </div>\n</section>\n\n<section class=\"ae-sec\" id=\"evolution\">\n  <h2>Comment l'évolution a convergé</h2>\n  <p class=\"ae-note\">Score combiné : 45 % vitesse vers 10 k€, 30 % potentiel licorne (échelle logarithmique), 25 % pérennité. Deux évolutions indépendantes, parties de populations aléatoires différentes.</p>\n  <div class=\"ae-chart ae-short\" data-draw=\"evo\" data-source=\"evolution\" role=\"img\" aria-label=\"Meilleur score et score moyen de la population à chaque génération\"></div>\n</section>\n\n<section class=\"ae-sec\" id=\"especes\">\n  <h2>Les espèces qui survivent</h2>\n  <p class=\"ae-note\">Part de la population occupée par chaque parcours, génération après génération (évolution 1).</p>\n  <div class=\"ae-chart\" data-draw=\"especes\" data-source=\"especes\" role=\"img\" aria-label=\"Part de la population par parcours au fil des générations\"></div>\n</section>\n\n<section class=\"ae-sec\" id=\"robustesse\">\n  <h2>Et si mes hypothèses sont fausses ?</h2>\n  <p class=\"ae-note\">L'évolution complète relancée dans <span data-draw=\"nb-mondes\" data-source=\"campagne\" data-field=\"mondes_perturbes\" data-row=\"0\">—</span> mondes où les hypothèses clés varient au hasard de ±30 à 50 % : facilité de vendre, de lever des fonds, multiples de valorisation, viralité, burnout, baisse des prix due à l'IA… Le parcours exact change d'un monde à l'autre ; voici par où il commence et par où il finit.</p>\n  <div class=\"ae-duo\">\n    <div class=\"ae-sec\">\n      <h3 class=\"ae-h3\">Dernière étape du parcours gagnant</h3>\n      <div class=\"ae-chart ae-bars\" data-draw=\"fin\" data-source=\"fin_parcours\" role=\"img\" aria-label=\"Nombre de mondes selon la dernière étape du parcours gagnant\"></div>\n    </div>\n    <div class=\"ae-sec\">\n      <h3 class=\"ae-h3\">Première étape du parcours gagnant</h3>\n      <div class=\"ae-chart ae-bars\" data-draw=\"debut\" data-source=\"debut_parcours\" role=\"img\" aria-label=\"Nombre de mondes selon la première étape du parcours gagnant\"></div>\n    </div>\n  </div>\n</section>\n\n<section class=\"ae-sec\" id=\"finalistes\">\n  <h2>Les finalistes des deux évolutions</h2>\n  <div class=\"ae-tablewrap\">\n    <table data-source=\"champions\" data-row-key=\"id\" aria-label=\"Finalistes\">\n      <thead><tr>\n        <th data-field=\"id\">Rang</th>\n        <th data-field=\"parcours\">Parcours</th>\n        <th data-field=\"secteur\">Secteur</th>\n        <th class=\"n\" data-field=\"p10k_24m_pct\">10 k€ en 24 mois</th>\n        <th class=\"n\" data-field=\"p_durable_60m_pct\">≥ 10 k€ à 5 ans</th>\n        <th class=\"n\" data-field=\"part_temps_10k_pct\">Temps à ≥ 10 k€, ans 3 à 10</th>\n        <th class=\"n\" data-field=\"p_licorne_pct\">Licorne</th>\n        <th class=\"n\" data-field=\"revenu_median_60m\">Revenu médian à 5 ans</th>\n      </tr></thead>\n      <tbody data-draw=\"tb-champions\"></tbody>\n    </table>\n  </div>\n</section>\n\n<details id=\"methode\">\n  <summary>Méthode, hypothèses et limites</summary>\n  <p>Chaque vie avance mois par mois pendant 10 ans. Au départ sont tirés au hasard le talent, la ténacité, l'épargne, la chance commerciale et la qualité d'entreprise ; en cours de route, les chocs de marché, les burnouts, les associés trouvés ou perdus et les levées de fonds réussies ou ratées. Une stratégie est un génome de 20 gènes : jusqu'à trois phases parmi 15 moteurs de revenus, leurs déclencheurs, le secteur, le canal, le prix, les heures, le financement, la géographie, l'associé, etc.</p>\n  <p>L'algorithme NSGA-II garde à chaque génération les stratégies non dominées sur trois objectifs (vitesse vers 10 k€/mois, potentiel licorne, pérennité), avec au plus 2 % de risque judiciaire. Toutes les stratégies d'une génération vivent les mêmes destins aléatoires, pour des comparaisons justes.</p>\n  <p>Le modèle est calé sur des données publiques : 1 à 5,6 % des startups ayant levé un seed deviennent licornes (CB Insights, Carta), environ 97 % des day traders qui persistent perdent de l'argent (Chague et al., 2019), la productivité plafonne au-delà de 50 h/semaine (Pencavel, 2014), et les multiples de valorisation IA de 2026 vont de 10 à 100 fois le revenu annuel (Tunguz). Pendant le calage, l'algorithme a exploité neuf failles du modèle, toutes corrigées (voir README).</p>\n  <p>Limites : ce sont des ordres de grandeur, pas des promesses. Le revenu est avant impôts et charges (25 à 45 % en France). La « fraude » n'est qu'un témoin aux paramètres illustratifs : elle sert à montrer que la sélection l'élimine.</p>\n</details>\n\n</div>\n\n<script>\n// Formats partagés (français)\nwindow.AE = (function () {\n  const fr = d3.formatLocale({ decimal: ',', thousands: ' ', grouping: [3], currency: ['', ' €'] });\n  const pct = (v) => (v == null || isNaN(v) ? '—' : fr.format(v >= 10 ? '.0f' : v >= 1 ? '.1f' : '.2f')(v));\n  const eur = (v) => (v == null || isNaN(v) ? '—' : fr.format(',.0f')(Math.round(v)) + ' €');\n  const big = (v) => {\n    if (v == null || isNaN(v)) return '—';\n    if (v >= 1e9) return fr.format(',.2f')(v / 1e9).replace(/,?0+$/, '') + ' milliards';\n    if (v >= 1e6) return fr.format(',.0f')(v / 1e6) + ' millions';\n    return fr.format(',.0f')(v);\n  };\n  const ok = (id) => dash.data(id).status === 'ok' && Array.isArray(dash.data(id).data) && dash.data(id).data.length > 0;\n  const fail = (el, id) => {\n    const s = dash.data(id).status;\n    if (s === 'error' || s === 'missing') { el.replaceChildren(); const p = document.createElement('div'); p.className = 'ae-fail'; p.textContent = 'Échec du chargement'; el.appendChild(p); return true; }\n    return false;\n  };\n  const tip = (el) => { let t = el.querySelector('.ae-tip'); if (!t) { t = document.createElement('div'); t.className = 'ae-tip'; t.hidden = true; el.appendChild(t); } return t; };\n  const place = (el, t, x, y) => {\n    const w = el.clientWidth, tw = t.offsetWidth, th = t.offsetHeight;\n    let left = x + 14; if (left + tw > w) left = Math.max(0, x - tw - 14);\n    let top = y - th - 10; if (top < 0) top = y + 14;\n    t.style.left = left + 'px'; t.style.top = top + 'px';\n  };\n  const colors = () => (dash.colors && dash.colors.length ? dash.colors : ['currentColor']);\n  return { fr, pct, eur, big, ok, fail, tip, place, colors };\n})();\n</script>\n\n<script>\n// Chiffres dans le texte et tuiles\n(function () {\n  const cell = (id, field, fmt) => (el) => {\n    const d = dash.data(id);\n    if (d.status !== 'ok' || !d.data || !d.data.length) { el.textContent = '—'; return; }\n    const v = d.data[0][field];\n    el.textContent = fmt ? fmt(v) : (v == null || v === '' ? '—' : String(v));\n  };\n  dash.draw('nb-gen', cell('campagne', 'generations', (v) => AE.fr.format(',.0f')(v)));\n  dash.draw('nb-vies', cell('campagne', 'vies_simulees', (v) => AE.fr.format(',.0f')(v)));\n  dash.draw('nb-mondes', cell('campagne', 'mondes_perturbes', (v) => String(v)));\n  dash.draw('champion', cell('champions', 'parcours'));\n  dash.draw('t-12', cell('champions', 'p10k_12m_pct', AE.pct));\n  dash.draw('t-24', cell('champions', 'p10k_24m_pct', AE.pct));\n  dash.draw('t-dur', cell('champions', 'p_durable_60m_pct', AE.pct));\n  dash.draw('t-part', cell('champions', 'part_temps_10k_pct', AE.pct));\n  dash.draw('t-lic', cell('champions', 'p_licorne_pct', AE.pct));\n  dash.draw('t-ab', cell('champions', 'p_abandon_pct', AE.pct));\n  const txt = (f) => cell('champions', f, (v) => (v == null || v === '' ? 'sans objet' : String(v)));\n  [['r-parcours', 'parcours'], ['r-p12', 'passage_1_2'], ['r-p23', 'passage_2_3'], ['r-secteur', 'secteur'],\n   ['r-canal', 'canal'], ['r-prix', 'prix'], ['r-heures', 'heures'], ['r-associe', 'associe'], ['r-geo', 'geographie'],\n   ['r-fin', 'financement'], ['r-levee', 'declencheur_levee'], ['r-pos', 'positionnement'], ['r-garder', 'garder_agence'],\n   ['r-reinv', 'reinvestissement'], ['r-learn', 'apprentissage'], ['r-contenu', 'contenu']].forEach(([n, f]) => dash.draw(n, txt(f)));\n})();\n</script>\n\n<script>\n// Tables\n(function () {\n  const td = (tr, text, cls) => { const c = document.createElement('td'); c.textContent = text; if (cls) c.className = cls; tr.appendChild(c); return c; };\n  dash.draw('tb-moteurs', (tb) => {\n    tb.replaceChildren();\n    if (!AE.ok('moteurs')) return;\n    dash.data('moteurs').data.forEach((r) => {\n      const tr = document.createElement('tr');\n      if (r.p_durable_60m < 0.01 && r.p_licorne < 0.0005 && r.p_catastrophe < 0.05) tr.className = 'ae-dead';\n      td(tr, r.moteur);\n      td(tr, r.reglages, 'ae-wrap');\n      td(tr, AE.pct(r.p10k_12m_pct) + ' %', 'n');\n      td(tr, AE.pct(r.p10k_24m_pct) + ' %', 'n');\n      td(tr, AE.pct(r.p_durable_60m_pct) + ' %', 'n');\n      td(tr, AE.pct(r.p_licorne_pct) + ' %', 'n');\n      td(tr, AE.pct(r.p_abandon_pct) + ' %', 'n');\n      const c = td(tr, AE.pct(r.p_catastrophe_pct) + ' %', 'n');\n      if (r.p_catastrophe_pct >= 5) c.style.color = 'var(--color-bad)';\n      td(tr, AE.eur(r.revenu_median_60m), 'n');\n      tb.appendChild(tr);\n    });\n  });\n  dash.draw('tb-champions', (tb) => {\n    tb.replaceChildren();\n    if (!AE.ok('champions')) return;\n    dash.data('champions').data.forEach((r) => {\n      const tr = document.createElement('tr');\n      td(tr, r.id);\n      td(tr, r.parcours, 'ae-wrap');\n      td(tr, r.secteur);\n      td(tr, AE.pct(r.p10k_24m_pct) + ' %', 'n');\n      td(tr, AE.pct(r.p_durable_60m_pct) + ' %', 'n');\n      td(tr, AE.pct(r.part_temps_10k_pct) + ' %', 'n');\n      td(tr, AE.pct(r.p_licorne_pct) + ' %', 'n');\n      td(tr, AE.eur(r.revenu_median_60m), 'n');\n      tb.appendChild(tr);\n    });\n  });\n  const pts = (v) => (v == null ? '—' : (v > 0 ? '+' : v < 0 ? '−' : '') + AE.pct(Math.abs(v)));\n  dash.draw('tb-variantes', (tb) => {\n    tb.replaceChildren();\n    if (!AE.ok('variantes')) return;\n    dash.data('variantes').data.forEach((r, i) => {\n      const tr = document.createElement('tr');\n      td(tr, r.variante, 'ae-wrap');\n      td(tr, AE.pct(r.p10k_24m_pct) + ' %', 'n');\n      const a = td(tr, i === 0 ? '' : pts(r.delta_24m_pts), 'n');\n      if (i > 0) a.style.color = r.delta_24m_pts > 0.5 ? 'var(--color-ok)' : r.delta_24m_pts < -0.5 ? 'var(--color-bad)' : '';\n      td(tr, AE.pct(r.p_durable_60m_pct) + ' %', 'n');\n      const b = td(tr, i === 0 ? '' : pts(r.delta_durable_pts), 'n');\n      if (i > 0) b.style.color = r.delta_durable_pts > 0.5 ? 'var(--color-ok)' : r.delta_durable_pts < -0.5 ? 'var(--color-bad)' : '';\n      td(tr, AE.pct(r.part_temps_10k_pct) + ' %', 'n');\n      td(tr, AE.pct(r.p_licorne_pct) + ' %', 'n');\n      td(tr, AE.pct(r.p_abandon_pct) + ' %', 'n');\n      if (i === 0) tr.style.fontWeight = 'var(--cds-font-weight-medium)';\n      tb.appendChild(tr);\n    });\n  });\n})();\n</script>\n\n<script>\n// Courbes : probabilité cumulée d'atteindre 10 k€/mois\ndash.draw('courbe', (el) => {\n  if (!AE.ok('courbe10k')) { if (!AE.fail(el, 'courbe10k')) el.replaceChildren(); return; }\n  const rows = dash.data('courbe10k').data;\n  const names = Array.from(new Set(rows.map((r) => r.strategie)));\n  const series = names.map((n) => ({ n, pts: rows.filter((r) => r.strategie === n).sort((a, b) => a.mois - b.mois) }));\n  const W = el.clientWidth || 600, H = 300, m = { t: 12, r: 16, b: 30, l: 40 };\n  el.replaceChildren();\n  const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img')\n    .attr('aria-label', 'Probabilité cumulée d’atteindre 10 000 € par mois');\n  const yMax = Math.max(5, d3.max(rows, (r) => r.p_10k_pct) * 1.08);\n  const x = d3.scaleLinear().domain([1, 120]).range([m.l, W - m.r]);\n  const y = d3.scaleLinear().domain([0, yMax]).nice().range([H - m.b, m.t]);\n  svg.append('g').attr('class', 'grid').attr('transform', `translate(${m.l},0)`).call(d3.axisLeft(y).ticks(5).tickSize(-(W - m.l - m.r)).tickFormat(''));\n  svg.append('g').attr('class', 'axis').attr('transform', `translate(0,${H - m.b})`).call(d3.axisBottom(x).tickValues([12, 24, 36, 48, 60, 84, 120]).tickFormat((d) => d + ' m'));\n  svg.append('g').attr('class', 'axis').attr('transform', `translate(${m.l},0)`).call(d3.axisLeft(y).ticks(5).tickFormat((d) => d + ' %'));\n  const C = AE.colors();\n  const line = d3.line().x((d) => x(d.mois)).y((d) => y(d.p_10k_pct));\n  series.forEach((s, i) => {\n    svg.append('path').datum(s.pts).attr('fill', 'none').style('stroke', C[i % C.length]).attr('stroke-width', i === 0 ? 3 : 1.6).attr('d', line);\n  });\n  const leg = document.createElement('div'); leg.className = 'ae-legend';\n  series.forEach((s, i) => { const sp = document.createElement('span'); const ic = document.createElement('i'); ic.style.background = C[i % C.length]; sp.appendChild(ic); sp.appendChild(document.createTextNode(s.n)); leg.appendChild(sp); });\n  el.appendChild(leg);\n  const t = AE.tip(el);\n  const vline = svg.append('line').attr('y1', m.t).attr('y2', H - m.b).style('stroke', 'var(--cds-chart-reference)').attr('opacity', 0);\n  svg.append('rect').attr('x', m.l).attr('y', m.t).attr('width', W - m.l - m.r).attr('height', H - m.t - m.b).attr('fill', 'transparent')\n    .on('pointermove', (ev) => {\n      const [px] = d3.pointer(ev);\n      const mo = Math.round(x.invert(px));\n      const vals = series.map((s, i) => { const p = s.pts.reduce((a, b) => (Math.abs(b.mois - mo) < Math.abs(a.mois - mo) ? b : a)); return { n: s.n, v: p.p_10k_pct, mois: p.mois, c: C[i % C.length] }; })\n        .sort((a, b) => b.v - a.v);\n      vline.attr('x1', x(vals[0].mois)).attr('x2', x(vals[0].mois)).attr('opacity', 1);\n      t.replaceChildren();\n      const h = document.createElement('div'); h.innerHTML = ''; const hb = document.createElement('b'); hb.textContent = 'Mois ' + vals[0].mois; h.appendChild(hb); t.appendChild(h);\n      vals.forEach((v) => { const d = document.createElement('div'); const k = document.createElement('span'); k.className = 'ae-k'; k.textContent = v.n + ' : '; d.appendChild(k); d.appendChild(document.createTextNode(AE.pct(v.v) + ' %')); t.appendChild(d); });\n      t.hidden = false;\n      const r = el.getBoundingClientRect(), sr = svg.node().getBoundingClientRect();\n      AE.place(el, t, ev.clientX - r.left, ev.clientY - r.top);\n    })\n    .on('pointerleave', () => { t.hidden = true; vline.attr('opacity', 0); });\n});\n</script>\n\n<script>\n// Convergence de l'évolution\ndash.draw('evo', (el) => {\n  if (!AE.ok('evolution')) { if (!AE.fail(el, 'evolution')) el.replaceChildren(); return; }\n  const rows = dash.data('evolution').data;\n  const runs = Array.from(new Set(rows.map((r) => r.run)));\n  const W = el.clientWidth || 600, H = 190, m = { t: 10, r: 16, b: 30, l: 40 };\n  el.replaceChildren();\n  const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-label', 'Score par génération');\n  const x = d3.scaleLinear().domain(d3.extent(rows, (r) => r.generation)).range([m.l, W - m.r]);\n  const y = d3.scaleLinear().domain([0, d3.max(rows, (r) => r.meilleure_utilite) * 1.1]).nice().range([H - m.b, m.t]);\n  svg.append('g').attr('class', 'grid').attr('transform', `translate(${m.l},0)`).call(d3.axisLeft(y).ticks(4).tickSize(-(W - m.l - m.r)).tickFormat(''));\n  svg.append('g').attr('class', 'axis').attr('transform', `translate(0,${H - m.b})`).call(d3.axisBottom(x).ticks(Math.max(2, Math.floor(W / 110))).tickFormat((d) => AE.fr.format(',.0f')(d)));\n  svg.append('g').attr('class', 'axis').attr('transform', `translate(${m.l},0)`).call(d3.axisLeft(y).ticks(4).tickFormat(AE.fr.format('.2f')));\n  const C = AE.colors();\n  const leg = document.createElement('div'); leg.className = 'ae-legend';\n  runs.forEach((run, i) => {\n    const pts = rows.filter((r) => r.run === run).sort((a, b) => a.generation - b.generation);\n    svg.append('path').datum(pts).attr('fill', 'none').style('stroke', C[i % C.length]).attr('stroke-width', 2.2).attr('d', d3.line().x((d) => x(d.generation)).y((d) => y(d.meilleure_utilite)));\n    svg.append('path').datum(pts).attr('fill', 'none').style('stroke', C[i % C.length]).attr('stroke-width', 1.2).attr('stroke-dasharray', '3 3').attr('opacity', 0.8).attr('d', d3.line().x((d) => x(d.generation)).y((d) => y(d.utilite_moyenne)));\n    [['meilleure stratégie', ''], ['moyenne de la population', 'dash']].forEach(([lab, kind]) => {\n      const sp = document.createElement('span'); const ic = document.createElement('i'); ic.style.background = C[i % C.length]; if (kind) ic.style.opacity = '0.5'; sp.appendChild(ic); sp.appendChild(document.createTextNode(run + ' : ' + lab)); leg.appendChild(sp);\n    });\n  });\n  el.appendChild(leg);\n  const t = AE.tip(el);\n  svg.append('rect').attr('x', m.l).attr('y', m.t).attr('width', W - m.l - m.r).attr('height', H - m.t - m.b).attr('fill', 'transparent')\n    .on('pointermove', (ev) => {\n      const [px] = d3.pointer(ev); const g = x.invert(px);\n      t.replaceChildren();\n      runs.forEach((run) => {\n        const pts = rows.filter((r) => r.run === run);\n        const p = pts.reduce((a, b) => (Math.abs(b.generation - g) < Math.abs(a.generation - g) ? b : a));\n        const d = document.createElement('div'); const b = document.createElement('b'); b.textContent = run + ', génération ' + AE.fr.format(',.0f')(p.generation); d.appendChild(b); t.appendChild(d);\n        const e = document.createElement('div'); e.textContent = 'meilleur score ' + AE.fr.format('.3f')(p.meilleure_utilite) + ' · ' + p.meilleur_parcours; t.appendChild(e);\n        const f = document.createElement('div'); f.className = 'ae-k'; f.textContent = AE.big(p.vies_millions * 1e6) + ' vies simulées à ce stade'; t.appendChild(f);\n      });\n      t.hidden = false; const r = el.getBoundingClientRect(); AE.place(el, t, ev.clientX - r.left, ev.clientY - r.top);\n    })\n    .on('pointerleave', () => { t.hidden = true; });\n});\n</script>\n\n<script>\n// Espèces : aires empilées\ndash.draw('especes', (el) => {\n  if (!AE.ok('especes')) { if (!AE.fail(el, 'especes')) el.replaceChildren(); return; }\n  const rows = dash.data('especes').data;\n  const keys = Array.from(new Set(rows.map((r) => r.parcours)));\n  const gens = Array.from(new Set(rows.map((r) => r.generation))).sort((a, b) => a - b);\n  const table = gens.map((g) => { const o = { generation: g }; keys.forEach((k) => { o[k] = 0; }); rows.filter((r) => r.generation === g).forEach((r) => { o[r.parcours] = r.part; }); return o; });\n  const W = el.clientWidth || 600, H = 300, m = { t: 8, r: 16, b: 30, l: 40 };\n  el.replaceChildren();\n  const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-label', 'Part de la population par parcours');\n  const x = d3.scaleLinear().domain(d3.extent(gens)).range([m.l, W - m.r]);\n  const y = d3.scaleLinear().domain([0, 1]).range([H - m.b, m.t]);\n  const C = AE.colors();\n  const col = (k, i) => (k === 'Autres' ? 'var(--cds-chart-muted)' : C[i % C.length]);\n  const st = d3.stack().keys(keys)(table);\n  svg.selectAll('path.a').data(st).join('path').attr('class', 'a').style('fill', (d, i) => col(d.key, i)).attr('opacity', 0.9)\n    .attr('d', d3.area().x((d) => x(d.data.generation)).y0((d) => y(d[0])).y1((d) => y(d[1])));\n  svg.append('g').attr('class', 'axis').attr('transform', `translate(0,${H - m.b})`).call(d3.axisBottom(x).ticks(Math.max(2, Math.floor(W / 110))).tickFormat((d) => AE.fr.format(',.0f')(d)));\n  svg.append('g').attr('class', 'axis').attr('transform', `translate(${m.l},0)`).call(d3.axisLeft(y).ticks(5).tickFormat((d) => Math.round(d * 100) + ' %'));\n  const leg = document.createElement('div'); leg.className = 'ae-legend';\n  keys.forEach((k, i) => { const sp = document.createElement('span'); const ic = document.createElement('i'); ic.className = 'ae-sq'; ic.style.background = col(k, i); sp.appendChild(ic); sp.appendChild(document.createTextNode(k)); leg.appendChild(sp); });\n  el.appendChild(leg);\n  const t = AE.tip(el);\n  svg.append('rect').attr('x', m.l).attr('y', m.t).attr('width', W - m.l - m.r).attr('height', H - m.t - m.b).attr('fill', 'transparent')\n    .on('pointermove', (ev) => {\n      const [px] = d3.pointer(ev); const g = x.invert(px);\n      const o = table.reduce((a, b) => (Math.abs(b.generation - g) < Math.abs(a.generation - g) ? b : a));\n      t.replaceChildren();\n      const h = document.createElement('div'); const b = document.createElement('b'); b.textContent = 'Génération ' + AE.fr.format(',.0f')(o.generation); h.appendChild(b); t.appendChild(h);\n      keys.filter((k) => o[k] > 0.005).sort((a, c) => o[c] - o[a]).forEach((k) => { const d = document.createElement('div'); const s = document.createElement('span'); s.className = 'ae-k'; s.textContent = k + ' : '; d.appendChild(s); d.appendChild(document.createTextNode(Math.round(o[k] * 100) + ' %')); t.appendChild(d); });\n      t.hidden = false; const r = el.getBoundingClientRect(); AE.place(el, t, ev.clientX - r.left, ev.clientY - r.top);\n    })\n    .on('pointerleave', () => { t.hidden = true; });\n});\n</script>\n\n<script>\n// Robustesse : première et dernière étape du parcours gagnant dans chaque monde perturbé\nconst etapes = (mondes, pick) => {\n  const c = {};\n  mondes.forEach((m) => { const parts = String(m.parcours).split(' → '); const k = pick(parts); c[k] = (c[k] || 0) + 1; });\n  return Object.keys(c).map((k) => ({ etape: k, mondes: c[k] })).sort((a, b) => b.mondes - a.mondes);\n};\ndash.calc('fin_parcours', {\n  inputs: ['mondes'], title: 'Dernière étape du parcours gagnant',\n  description: 'Nombre de mondes perturbés selon la dernière étape du parcours qui y gagne.',\n  fn: (mondes) => etapes(mondes, (parts) => parts[parts.length - 1]),\n});\ndash.calc('debut_parcours', {\n  inputs: ['mondes'], title: 'Première étape du parcours gagnant',\n  description: 'Nombre de mondes perturbés selon la première étape du parcours qui y gagne.',\n  fn: (mondes) => etapes(mondes, (parts) => parts[0]),\n});\nconst barres = (id) => (el) => {\n  const d = dash.data(id);\n  if (d.status !== 'ok' || !Array.isArray(d.data) || !d.data.length) { if (d.status === 'error') AE.fail(el, id); else el.replaceChildren(); return; }\n  const rows = d.data, tot = d3.sum(rows, (r) => r.mondes);\n  const W = el.clientWidth || 300, bh = 26, m = { t: 2, r: 8, b: 4, l: 4 };\n  const H = m.t + m.b + rows.length * bh;\n  el.replaceChildren();\n  const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-label', 'Mondes gagnés');\n  const x = d3.scaleLinear().domain([0, d3.max(rows, (r) => r.mondes)]).range([0, Math.max(40, (W - m.l - m.r) * 0.42)]);\n  const C = AE.colors();\n  const g = svg.selectAll('g.r').data(rows).join('g').attr('class', 'r').attr('transform', (r, i) => `translate(${m.l},${m.t + i * bh})`);\n  g.append('rect').attr('y', 4).attr('height', bh - 10).attr('width', (r) => x(r.mondes)).style('fill', (r, i) => (i === 0 ? C[0] : 'var(--cds-chart-muted)')).attr('rx', 2);\n  g.append('text').attr('x', (r) => x(r.mondes) + 8).attr('y', bh / 2 + 1).attr('dominant-baseline', 'middle')\n    .style('fill', 'var(--color-fg)').style('font-size', 'var(--cds-font-size-caption)')\n    .text((r) => r.etape + ' · ' + r.mondes + ' sur ' + tot);\n};\ndash.draw('fin', barres('fin_parcours'));\ndash.draw('debut', barres('debut_parcours'));\n</script>\n\n<script>\n// Revenu mois par mois (bandes de quantiles)\ndash.draw('traj', (el) => {\n  if (!AE.ok('trajectoire')) { if (!AE.fail(el, 'trajectoire')) el.replaceChildren(); return; }\n  const rows = dash.data('trajectoire').data.slice().sort((a, b) => a.mois - b.mois);\n  const W = el.clientWidth || 600, H = 300, m = { t: 12, r: 16, b: 30, l: 48 };\n  el.replaceChildren();\n  const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-label', 'Revenu mensuel par mois');\n  const x = d3.scaleLinear().domain([1, 120]).range([m.l, W - m.r]);\n  const lo = Math.min(0, d3.min(rows, (r) => r.p10)), hi = d3.max(rows, (r) => r.p90) * 1.05;\n  const y = d3.scaleLinear().domain([lo, hi]).nice().range([H - m.b, m.t]);\n  svg.append('g').attr('class', 'grid').attr('transform', `translate(${m.l},0)`).call(d3.axisLeft(y).ticks(5).tickSize(-(W - m.l - m.r)).tickFormat(''));\n  const C = AE.colors();\n  svg.append('path').datum(rows).style('fill', C[0]).attr('opacity', 0.14).attr('d', d3.area().x((d) => x(d.mois)).y0((d) => y(d.p10)).y1((d) => y(d.p90)));\n  svg.append('path').datum(rows).style('fill', C[0]).attr('opacity', 0.28).attr('d', d3.area().x((d) => x(d.mois)).y0((d) => y(d.p25)).y1((d) => y(d.p75)));\n  svg.append('path').datum(rows).attr('fill', 'none').style('stroke', C[0]).attr('stroke-width', 2.2).attr('d', d3.line().x((d) => x(d.mois)).y((d) => y(d.mediane)));\n  svg.append('line').attr('x1', m.l).attr('x2', W - m.r).attr('y1', y(10000)).attr('y2', y(10000)).style('stroke', 'var(--cds-chart-reference)').attr('stroke-dasharray', '4 3');\n  svg.append('text').attr('x', W - m.r).attr('y', y(10000) - 5).attr('text-anchor', 'end').style('fill', 'var(--cds-text-secondary)').style('font-size', 'var(--cds-font-size-caption)').text('10 k€/mois');\n  svg.append('g').attr('class', 'axis').attr('transform', `translate(0,${H - m.b})`).call(d3.axisBottom(x).tickValues([12, 24, 36, 48, 60, 72, 84, 96, 108, 120]).tickFormat((d) => (d / 12) + ' an' + (d > 12 ? 's' : '')));\n  svg.append('g').attr('class', 'axis').attr('transform', `translate(${m.l},0)`).call(d3.axisLeft(y).ticks(5).tickFormat((d) => AE.fr.format(',.0f')(d / 1000) + ' k€'));\n  const t = AE.tip(el);\n  const vline = svg.append('line').attr('y1', m.t).attr('y2', H - m.b).style('stroke', 'var(--cds-chart-reference)').attr('opacity', 0);\n  svg.append('rect').attr('x', m.l).attr('y', m.t).attr('width', W - m.l - m.r).attr('height', H - m.t - m.b).attr('fill', 'transparent')\n    .on('pointermove', (ev) => {\n      const [px] = d3.pointer(ev); const mo = Math.max(1, Math.min(120, Math.round(x.invert(px))));\n      const r = rows.find((d) => d.mois === mo) || rows[0];\n      vline.attr('x1', x(r.mois)).attr('x2', x(r.mois)).attr('opacity', 1);\n      t.replaceChildren();\n      const h = document.createElement('div'); const b = document.createElement('b'); b.textContent = 'Mois ' + r.mois; h.appendChild(b); t.appendChild(h);\n      [['médiane', r.mediane], ['25 % à 75 %', null], ['10 % à 90 %', null]].forEach(([k, v], i) => {\n        const d = document.createElement('div'); const s = document.createElement('span'); s.className = 'ae-k'; s.textContent = k + ' : '; d.appendChild(s);\n        d.appendChild(document.createTextNode(i === 0 ? AE.eur(v) : i === 1 ? AE.eur(r.p25) + ' à ' + AE.eur(r.p75) : AE.eur(r.p10) + ' à ' + AE.eur(r.p90)));\n        t.appendChild(d);\n      });\n      const e = document.createElement('div'); const s2 = document.createElement('span'); s2.className = 'ae-k'; s2.textContent = 'vies à ≥ 10 k€ ce mois-là : '; e.appendChild(s2); e.appendChild(document.createTextNode(AE.pct(r.part_10k_pct) + ' %')); t.appendChild(e);\n      t.hidden = false; const rr = el.getBoundingClientRect(); AE.place(el, t, ev.clientX - rr.left, ev.clientY - rr.top);\n    })\n    .on('pointerleave', () => { t.hidden = true; vline.attr('opacity', 0); });\n});\n</script>\n"}